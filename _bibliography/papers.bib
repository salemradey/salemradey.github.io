@misc{radey2026challengesfuturedirectionsagentic,
      title={Challenges and Future Directions in Agentic Reverse Engineering Systems}, 
      author={Salem Radey and Jack West and Kassem Fawaz},
      year={2026},
      eprint={2604.14317},
      archivePrefix={arXiv},
      primaryClass={cs.CR},
      url={https://arxiv.org/abs/2604.14317}, 
      doi={/10.48550/arXiv.2604.14317},
      abstract = {Agentic systems built on large language models (LLMs) are increasingly being used for complex security tasks, 
      including binary reverse engineering (RE). Despite recent growth in popularity and capability, these systems continue to face 
      limitations in realistic settings. Cutting-edge systems still fail in complex RE scenarios that involve obfuscation, timing, 
      and unique architecture. In this work, we examine how agentic systems perform reverse engineering tasks with static, dynamic, 
      and hybrid agents. Through an analysis of existing agentic tool usage, we identify several limitations, including token 
      constraints, struggles with obfuscation, and a lack of program guardrails. From these findings, we outline current challenges 
      and position future directions for system designers to overcome from a security perspective.},
      journal = {Secure Agents for Generative Artificial Intelligence (SAGAI)},
      month = May,
      Year = {2026},
      keywords = {official},
}

@misc{TheftAndStalking2026,
  title={Theft & Stalking: An Evaluation of Current Bluetooth Low Energy
Tracking Device Capabilities},
  abstract={Modern consumer Bluetooth low energy (BLE) tracking devices are
designed to help users locate items and many users additionally
use these devices to recover items after theft. However, due to the
nature of these tracking devices, they can also be used to facilitate
stalking and intimate partner violence by allowing a user to track
another person without their knowledge. To counter this, many
manufacturers have added ’anti-stalking’ features such as proximity
alerts, audio pings, and in-app detection scans.
In 2023 researchers at Apple and Google submitted the first draft
of the Detecting Unwanted Location Trackers (DULT) charter to
the Internet Engineering Task Force (IETF) with the goal of stan-
dardizing the construction and behaviors of BLE tracking devices
to allow the issuance of unwanted location tracking alerts. Now, in
2025, this charter has been approved by the IETF.
Despite the push by industry leaders for stronger anti-stalking
protections, many users and manufacturers worry that the stringent
guidelines may make it easier for a thief to notice a tracking de-
vice; thereby rendering a perceived core functionality of the device
obsolete.
This paper seeks to quantify the trade-offs of anti-theft and
anti-stalking made by popular devices and apps based on their
policy. We compare the written policy of Life360 Tile Mate (2024),
Apple AirTag, Samsung SmartTag2, Chipolo ONE, Pebblebee Clip
5, and their companion apps. Additionally, this work investigates
manufacturer adherence to DULT protocols as laid out in the IETF
charter. We find that across 111 DULT guidelines, adherence rates
ranged from 5.4% - 21.6% with Apple AirTags having the highest
adherence rate and Life360 Tile Mate (2024) trackers having the
lowest adherence with the most amount of explicit violations.},
  author={Salem Radey},
  month= May,
  year={2026},
  keywords={student},
  pdf={paper_TheftAndStalking2026.pdf}
}